# Copy to /etc/planering/tidrapport-sync.env, root-owned, mode 0600.
# This example is DISABLED until Tidrapport has an authenticated receiver.
PLANERING_DATA_DIR=/var/lib/resursplanering-test-access/data
TIDRAPPORT_SYNC_INSTANCE=planering-test-3200
TIDRAPPORT_SYNC_STATE=/var/lib/resursplanering-test-access/tidrapport-sync/state.json

# Must be the VERIFIED receiver API endpoint (not the Tidrapport home page).
TIDRAPPORT_SYNC_ENDPOINT=https://replace-with-tidrapport-api.example/api/integrations/planering/time-entries
TIDRAPPORT_SYNC_TOKEN=REPLACE-WITH-A-LONG-RANDOM-BEARER-TOKEN
TIDRAPPORT_SYNC_ENABLED=no
TIDRAPPORT_SYNC_LIMIT=100
TIDRAPPORT_SYNC_TIMEOUT_MS=15000
